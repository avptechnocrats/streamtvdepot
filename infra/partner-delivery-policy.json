{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageDedicatedDeliveryBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket", "s3:ListBucket", "s3:GetBucketLocation",
        "s3:GetBucketTagging", "s3:PutBucketTagging",
        "s3:GetBucketPublicAccessBlock", "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls", "s3:PutBucketOwnershipControls",
        "s3:GetEncryptionConfiguration", "s3:PutEncryptionConfiguration",
        "s3:GetBucketVersioning", "s3:PutBucketVersioning",
        "s3:GetLifecycleConfiguration", "s3:PutLifecycleConfiguration",
        "s3:GetBucketPolicy", "s3:PutBucketPolicy",
        "s3:GetBucketNotification", "s3:PutBucketNotification"
      ],
      "Resource": "arn:aws:s3:::stv-delivery-*"
    },
    {
      "Sid": "ReadVersionedDeliveries",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::stv-delivery-*/incoming/*"
    },
    {
      "Sid": "ManageDedicatedDeliveryQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue", "sqs:GetQueueUrl", "sqs:GetQueueAttributes", "sqs:SetQueueAttributes",
        "sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:<REGION>:<PLATFORM_ACCOUNT_ID>:stv-delivery-*"
    },
    {
      "Sid": "CheckProductionSourceExistence",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<PRODUCTION_BUCKET>",
      "Condition": { "StringLike": { "s3:prefix": "*/partners/*" } }
    },
    {
      "Sid": "CopyValidatedProductionSources",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::<PRODUCTION_BUCKET>/*/partners/*"
    }
  ]
}