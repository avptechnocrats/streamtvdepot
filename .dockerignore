# Python / backend local files (not needed in frontend build context)
backend/.venv
backend/venv
backend/__pycache__
backend/.pytest_cache
backend/.mypy_cache
backend/.ruff_cache

# Docker and misc
*.pid
*.tmp
*.swp

# Large media/generated folders if they exist
**/node_modules
**/.next
**/out
**/coverage
**/.cache
