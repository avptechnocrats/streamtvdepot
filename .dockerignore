# Git
.git
.gitignore
.github

# Node / frontend build artifacts
frontend/node_modules
frontend/.next
frontend/out
frontend/coverage
frontend/.turbo
frontend/.cache


# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor files
.DS_Store
Thumbs.db
.vscode
