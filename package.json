{
  "name": "signalview-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "bash scripts/run-android.sh",
    "apk:debug": "grep -vE '^[[:space:]]*#|^[[:space:]]*$' active-client | head -n1 | xargs -I{} bash scripts/build.sh {} android debug",
    "apk:release": "grep -vE '^[[:space:]]*#|^[[:space:]]*$' active-client | head -n1 | xargs -I{} bash scripts/build.sh {} android release",
    "aab:release": "grep -vE '^[[:space:]]*#|^[[:space:]]*$' active-client | head -n1 | xargs -I{} bash scripts/build.sh {} android aab",
    "ios": "react-native run-ios",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.56.2",
    "axios": "^1.7.7",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^2.16.2",
    "react-native-keychain": "^8.2.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^3.10.1",
    "react-native-safe-area-context": "^4.10.5",
    "react-native-screens": "^3.31.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^6.9.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/babel-preset": "^0.74.0",
    "@react-native/metro-config": "^0.74.0",
    "@types/react": "^18.2.79",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-plugin-module-resolver": "^5.0.2",
    "patch-package": "^8.0.1",
    "typescript": "^5.6.3"
  }
}
