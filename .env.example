# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=xxx
POSTGRES_USER=xxx
POSTGRES_PASSWORD=xxx
DATABASE_URL=postgresql+asyncpg://xxx:xxx@postgres:5432/xxx
# API services use a bounded reusable pool. Celery services use NullPool via docker-compose.
API_DATABASE_POOL_SIZE=5
API_DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
BILLING_WORKER_CONCURRENCY=4
NOTIFICATION_WORKER_CONCURRENCY=4

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Superadmin seed ─────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=xxx
SUPERADMIN_PASSWORD=xxx

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=xxx
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET=xxx
AWS_REGION=us-east-1

# ─── Managed live pipeline (MediaLive → MediaPackage v2 → CloudFront, MediaTailor ads) ──
# Shared infra: infra/live-streaming.yaml. The admin picks Legacy RTMP or AWS MediaLive per channel;
# LIVE_PIPELINE is only the preselected choice (AWS is offered once every setting below is filled in).
LIVE_PIPELINE=legacy
LIVE_AWS_REGION=us-east-1
MEDIALIVE_ROLE_ARN=
LIVE_INGEST_ALLOWED_CIDRS=[]
MEDIAPACKAGE_CHANNEL_GROUP=stv-live
LIVE_CLOUDFRONT_DOMAIN=
LIVE_CLOUDFRONT_DISTRIBUTION_ARN=
LIVE_CF_KEY_PAIR_ID=
LIVE_CF_PRIVATE_KEY_PEM=
LIVE_CF_COOKIE_DOMAIN=
LIVE_TENANT_CDN_DOMAINS={}
LIVE_MEDIATAILOR_TRANSCODE_PROFILE=
LIVE_DVR_WINDOW_SECONDS=14400
LIVE_AD_DECISION_SERVER_URL=
LIVE_SLATE_AD_URL=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@streamtvdepot.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@streamtvdepot.com
BREVO_SENDER_NAME=