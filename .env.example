# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=xxx
POSTGRES_USER=xxx
POSTGRES_PASSWORD=xxx
DATABASE_URL=postgresql+asyncpg://xxx:xxx@postgres:5432/xxx
# API services use a bounded reusable pool. Celery services use NullPool via docker-compose.
API_DATABASE_POOL_SIZE=5
API_DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
BILLING_WORKER_CONCURRENCY=4
NOTIFICATION_WORKER_CONCURRENCY=4

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Superadmin seed ─────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=xxx
SUPERADMIN_PASSWORD=xxx

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=xxx
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET=xxx
AWS_REGION=us-east-1

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@signalview.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=